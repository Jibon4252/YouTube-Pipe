<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>YouTube Pipe - Jibon Roy</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box}
  body{
    font-family:"Roboto","Segoe UI",Arial,sans-serif;
    background:#0f0f0f;color:#fff;
    -webkit-font-smoothing:antialiased;
  }
  svg{display:block}
  button{border:none;background:none;font-family:inherit;cursor:pointer;color:inherit}

  /* HEADER */
  .header{
    position:fixed;top:0;left:0;right:0;height:56px;
    display:flex;align-items:center;justify-content:space-between;
    padding:0 16px;background:#0f0f0f;z-index:1000;
    border-bottom:1px solid #222;
  }
  .header-left{display:flex;align-items:center;gap:16px;flex:1 1 200px;min-width:0}
  .header-center{display:flex;align-items:center;gap:8px;flex:0 1 720px;min-width:0;width:100%}
  .header-right{display:flex;align-items:center;justify-content:flex-end;gap:8px;flex:1 1 200px;min-width:0}

  .icon-btn{
    width:40px;height:40px;border-radius:50%;flex-shrink:0;
    display:flex;align-items:center;justify-content:center;color:#fff;
  }
  .icon-btn:hover{background:#272727}
  .icon-btn svg{width:24px;height:24px}

  .logo{display:flex;align-items:center;gap:6px;flex-shrink:0;cursor:pointer}
  .logo .word{
    font-size:20px;font-weight:700;letter-spacing:-1.1px;
    font-family:"Arial Black","Roboto",Arial,sans-serif;
    color:#fff;
  }

  /* search */
  .search-form{display:flex;flex:1;height:40px;min-width:0}
  .search-input-wrap{
    display:flex;align-items:center;flex:1;min-width:0;
    border:1px solid #303030;border-right:none;border-radius:40px 0 0 40px;
    padding:0 16px;background:#121212;
  }
  .search-input{
    flex:1;min-width:0;border:none;outline:none;font-size:16px;
    font-family:inherit;background:transparent;color:#fff;
  }
  .search-btn{
    width:64px;border:1px solid #303030;border-radius:0 40px 40px 0;
    background:#222;display:flex;align-items:center;justify-content:center;
    color:#fff;flex-shrink:0;
  }
  .search-btn svg{width:24px;height:24px}

  /* MAIN */
  .main{padding:72px 16px 40px 16px}

  .chips{
    display:flex;gap:12px;padding-bottom:12px;overflow-x:auto;
    position:sticky;top:56px;background:#0f0f0f;z-index:800;
  }
  .chips::-webkit-scrollbar{display:none}
  .chip{
    flex:0 0 auto;height:32px;padding:0 12px;border-radius:8px;
    background:#272727;font-size:14px;font-weight:500;color:#fff;
    white-space:nowrap;display:flex;align-items:center;
  }
  .chip.active{background:#fff;color:#000}

  .video-grid{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(280px,1fr));
    gap:24px 16px;
    margin-top:12px;
  }

  .video-card{cursor:pointer}
  .thumb{
    position:relative;width:100%;aspect-ratio:16/9;
    border-radius:12px;overflow:hidden;background:#212121;
  }
  .thumb img{width:100%;height:100%;object-fit:cover;display:block}
  .duration{
    position:absolute;right:8px;bottom:8px;
    background:rgba(0,0,0,.8);color:#fff;
    font-size:12px;font-weight:500;
    padding:2px 6px;border-radius:4px;
  }

  .meta{display:flex;gap:12px;margin-top:12px}
  .meta .avatar{width:36px;height:36px;border-radius:50%;flex-shrink:0;object-fit:cover;background:#444}
  .meta-info{flex:1;min-width:0}
  .v-title{
    font-size:15px;font-weight:600;line-height:20px;color:#fff;
    display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;
    overflow:hidden;
  }
  .v-channel{margin-top:4px;font-size:13px;color:#aaa}
  .v-stats{font-size:13px;color:#aaa}
</style>
</head>
<body>

<header class="header">
  <div class="header-left">
    <div class="logo">
      <svg width="28" height="20" viewBox="0 0 30 21">
        <rect width="30" height="21" rx="5.5" fill="#FF0000"/>
        <path d="M12.2 5.6 20.5 10.5 12.2 15.4Z" fill="#fff"/>
      </svg>
      <span class="word">YouTube Pipe</span>
    </div>
  </div>

  <div class="header-center">
    <form class="search-form" onsubmit="return false">
      <div class="search-input-wrap">
        <input class="search-input" type="text" placeholder="Search">
      </div>
      <button class="search-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
          <circle cx="10.8" cy="10.8" r="6.3"/>
          <path d="M15.5 15.5 21 21" stroke-linecap="round"/>
        </svg>
      </button>
    </form>
  </div>

  <div class="header-right">
    <button class="icon-btn" onclick="Android.openSettings()" title="Settings">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
        <circle cx="12" cy="12" r="3"/>
        <path d="M19.4 15a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-1.8-.3 1.6 1.6 0 0 0-1 1.5v.2a2 2 0 1 1-4 0v-.1a1.6 1.6 0 0 0-1-1.5 1.6 1.6 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.6 1.6 0 0 0 .3-1.8 1.6 1.6 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.6 1.6 0 0 0 1.5-1 1.6 1.6 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.6 1.6 0 0 0 1.8.3H9a1.6 1.6 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.6 1.6 0 0 0 1 1.5 1.6 1.6 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.6 1.6 0 0 0-.3 1.8V9a1.6 1.6 0 0 0 1.5 1h.2a2 2 0 1 1 0 4h-.1a1.6 1.6 0 0 0-1.5 1Z"/>
      </svg>
    </button>
  </div>
</header>

<main class="main">
  <div class="chips">
    <button class="chip active">All</button>
    <button class="chip">Music</button>
    <button class="chip">Gaming</button>
    <button class="chip">Live</button>
    <button class="chip">Podcasts</button>
    <button class="chip">Programming</button>
  </div>

  <div class="video-grid">
    <div class="video-card" onclick="alert('Playing Video...')">
      <div class="thumb">
        <img src="https://picsum.photos/seed/yt01/640/360" alt="">
        <span class="duration">18:42</span>
      </div>
      <div class="meta">
        <div class="avatar"></div>
        <div class="meta-info">
          <div class="v-title">Building Custom Android App with Jibon Roy UI Layout</div>
          <div class="v-channel">Jibon Tech</div>
          <div class="v-stats">1.2M views · 2 days ago</div>
        </div>
      </div>
    </div>

    <div class="video-card" onclick="alert('Playing Video...')">
      <div class="thumb">
        <img src="https://picsum.photos/seed/yt02/640/360" alt="">
        <span class="duration">12:11</span>
      </div>
      <div class="meta">
        <div class="avatar"></div>
        <div class="meta-info">
          <div class="v-title">Advanced Termux Scripting & Automation Guide</div>
          <div class="v-channel">Code Master</div>
          <div class="v-stats">450K views · 1 week ago</div>
        </div>
      </div>
    </div>
  </div>
</main>
</body>
</html>
