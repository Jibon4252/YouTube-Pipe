<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D12"
    android:gravity="center">

    <LinearLayout
        android:id="@+id/splashContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <ImageView
            android:layout_width="104dp"
            android:layout_height="76dp"
            android:contentDescription="YouTube-Pipe logo"
            android:src="@drawable/splash_logo"
            android:elevation="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="YouTube-Pipe"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:fontFamily="sans"
            android:letterSpacing="0.02"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Your videos. Your way."
            android:textColor="#AAB2C0"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/splashProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="150dp"
            android:layout_height="3dp"
            android:layout_marginTop="34dp"
            android:indeterminate="true"
            android:indeterminateTint="#FF424F"
            android:progressTint="#FF424F" />

        <TextView
            android:id="@+id/splashStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Preparing your experience..."
            android:textColor="#8D96A5"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="52dp"
            android:text="CREATED BY"
            android:textColor="#777F8D"
            android:textSize="10sp"
            android:letterSpacing="0.18" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Jibon Roy"
            android:textColor="#FF6671"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>
</RelativeLayout>
